# ─── Macho ya Mwananchi — Server Environment Variables ────────
# Copy to .env and fill in real values. NEVER commit .env to git.

# ── Server ────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Database ──────────────────────────────────────────────────
# Local dev: mongodb://127.0.0.1:27017/macho-ya-mwananchi
# Production: MongoDB Atlas connection string (cloud.mongodb.com)
MONGO_URI=mongodb://127.0.0.1:27017/macho-ya-mwananchi

# ── CORS ──────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
CLIENT_URL=http://localhost:5173

# ── AI (FREE — no credit card needed) ────────────────────────
# Get key at: https://aistudio.google.com/app/apikey
# Free tier has both per-minute and per-day limits; both return
# RESOURCE_EXHAUSTED. Testing alone can exhaust the daily quota.
GEMINI_API_KEY=AIza...

# Python RAG microservice URL. The server proxies AI requests here.
AI_SERVICE_URL=http://localhost:8002

# Webhook posted to when an AI query fails. Unset = alerting disabled.
AUDIT_ALERT_WEBHOOK=

# ── Security ──────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
ADMIN_TOKEN=replace_with_random_token

# ── Testing only ──────────────────────────────────────────────
# Bypasses all rate limiters so the E2E suite can run. NEVER set this in
# production — it disables abuse protection on report and verification
# submission.
# DISABLE_RATE_LIMIT=1
