# ─── Macho ya Mwananchi — Environment Variables ───────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ── Server ────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Database ──────────────────────────────────────────────────
# Local dev default: mongodb://127.0.0.1:27017/macho-ya-mwananchi
# Production: use MongoDB Atlas connection string
MONGO_URI=mongodb://127.0.0.1:27017/macho-ya-mwananchi

# ── CORS ──────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
# Dev: http://localhost:5173
# Production: https://machoyamwananchi.co.ke
CLIENT_URL=http://localhost:5173

# ── AI Services ───────────────────────────────────────────────
# Anthropic Claude API — get from console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Python RAG microservice URL (Section 2)
AI_SERVICE_URL=http://localhost:8002

# ── Auth ──────────────────────────────────────────────────────
# JWT secret — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_64_char_random_hex_string

# Admin token for PDF ingest endpoint
ADMIN_TOKEN=replace_with_random_token

# ── Maps ──────────────────────────────────────────────────────
# Mapbox public token — get from mapbox.com
# Also add VITE_MAPBOX_TOKEN to client/.env for frontend use
MAPBOX_TOKEN=pk.eyJ1Ijoi...

# ── Vault Encryption ──────────────────────────────────────────
# AES-256 requires exactly 32 characters
# Generate: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
VAULT_ENCRYPTION_KEY=replace_with_exactly_32_characters!!
