# ─── Macho ya Mwananchi — Docker Compose environment ──────────
# Copy to .env and fill in real values. NEVER commit .env to git.
# Per-service templates: server/.env.example, ai-service/.env.example,
# client/.env.example

# ── Required ──────────────────────────────────────────────────
# Get your FREE Gemini key at: https://aistudio.google.com/app/apikey
# Free tier is generous but finite — both per-minute and per-day limits
# return RESOURCE_EXHAUSTED, and testing alone can exhaust it.
GEMINI_API_KEY=AIza...

MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/macho-ya-mwananchi

# Protects admin routes (/api/audit/ingest). Generate with:
#   openssl rand -hex 32
ADMIN_TOKEN=

# ── Optional (defaults shown) ─────────────────────────────────
# Comma-separated CORS allowlist. Set to your Render URL in production.
CLIENT_URL=http://localhost

# Ordered Gemini model chain. Only a 404/NOT_FOUND walks to the next
# candidate, so a retired model degrades instead of taking Audit AI offline.
# (gemini-2.0-flash was retired 1 Jun 2026 and the hardcoded name took the
# service down for three months — hence the chain.)
# Avoid gemini-2.5-* — retires 16 Oct 2026.
GEMINI_MODEL=gemini-3.6-flash,gemini-3.7-flash,gemini-flash-latest

# Cosine-distance ceiling for RAG retrieval. Chroma returns a top-K result
# however poor the match, so this rejects off-topic retrievals. Measured on
# this corpus: real audit questions 0.41-0.63, off-topic 0.75-0.91.
# Swahili scores ~0.1 worse than English (the ONNX embedder is English-centric).
RELEVANCE_MAX_DISTANCE=0.72

# Webhook for AI failure alerts. Unset = alerting disabled.
AUDIT_ALERT_WEBHOOK=

# Bypass rate limiting. FOR HERMETIC E2E RUNS ONLY — never set in production.
# DISABLE_RATE_LIMIT=1
