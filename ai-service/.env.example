# ─── Macho ya Mwananchi — AI service (FastAPI) ────────────────
# Copy to .env and fill in real values. NEVER commit .env to git.

# ── Required ──────────────────────────────────────────────────
# Same key as the Node server. https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIza...

# ── Model selection ───────────────────────────────────────────
# Ordered, comma-separated chain. Only a 404/NOT_FOUND walks to the next
# candidate — auth and quota errors still surface to the caller, because
# silently retrying those hides a real problem.
# Avoid gemini-2.5-* — retires 16 Oct 2026.
GEMINI_MODEL=gemini-3.6-flash,gemini-3.7-flash,gemini-flash-latest

# ── Retrieval quality ─────────────────────────────────────────
# Maximum cosine distance for a retrieved chunk to be considered relevant.
# ChromaDB always returns top-K, however poor the match, so without this floor
# an off-topic question retrieves unrelated audit text and gets an answer built
# on it. Measured on this corpus: genuine audit questions 0.41-0.63, off-topic
# 0.75-0.91. Raise with care — this is the guard against confident nonsense.
RELEVANCE_MAX_DISTANCE=0.72

# ── Service config ────────────────────────────────────────────
# Comma-separated CORS allowlist for the FastAPI service.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001

# Protects POST /ingest.
ADMIN_TOKEN=replace_with_random_token

# Ingest the PDF corpus at boot instead of at build time. Leave unset in
# production: Render's free tier has an ephemeral disk, so the index is baked
# into the image at build time (see render.yaml / Dockerfile) to survive cold
# starts. Useful locally for a one-off rebuild.
# INGEST_CORPUS_ON_STARTUP=1
